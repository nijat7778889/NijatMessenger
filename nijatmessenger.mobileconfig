<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>PayloadContent</key>
  <array>
    <dict>
      <!-- Web Clip: значок на домашнем экране, открывающий приложение
           отдельным окном, без адресной строки и вкладок Safari. -->
      <key>PayloadType</key>
      <string>com.apple.webClip.managed</string>
      <key>PayloadIdentifier</key>
      <string>com.nijatmessenger.webclip</string>
      <key>PayloadUUID</key>
      <string>8B1D4F22-77C6-4E93-A0F5-2C6E9B3D1A47</string>
      <key>PayloadVersion</key>
      <integer>1</integer>
      <key>PayloadDisplayName</key>
      <string>NijatMessenger на домашний экран</string>
      <key>Label</key>
      <string>NijatMessenger</string>
      <key>URL</key>
      <string>https://nijat7778889.github.io/NijatMessenger/rn/</string>
      <!-- Значок отдаётся вместе с профилем: тянуть его из сети iOS не станет,
           и без этих байтов на домашнем экране появился бы серый квадрат. -->
      <key>Icon</key>
      <data>

      </data>
      <!-- Открывать как приложение, а не как вкладку. -->
      <key>FullScreen</key>
      <true/>
      <!-- Значок уже скруглён: без этого iOS наложит скругление второй раз. -->
      <key>Precomposed</key>
      <true/>
      <!-- Удалять можно обычным долгим нажатием, как любое приложение. -->
      <key>IsRemovable</key>
      <true/>
      <key>IgnoreManifestScope</key>
      <true/>
    </dict>
  </array>
  <key>PayloadType</key>
  <string>Configuration</string>
  <key>PayloadIdentifier</key>
  <string>com.nijatmessenger.profile</string>
  <key>PayloadUUID</key>
  <string>3F6C2E10-9A41-4C7B-8E52-1D0B7A4E5C90</string>
  <key>PayloadVersion</key>
  <integer>1</integer>
  <key>PayloadDisplayName</key>
  <string>NijatMessenger</string>
  <key>PayloadOrganization</key>
  <string>NijatMessenger</string>
  <key>PayloadDescription</key>
  <string>Ставит значок NijatMessenger на домашний экран iPhone. Профиль не запрашивает никаких данных и не меняет настройки телефона — только добавляет ярлык, который открывается как приложение.</string>
  <key>PayloadRemovalDisallowed</key>
  <false/>
</dict>
</plist>
